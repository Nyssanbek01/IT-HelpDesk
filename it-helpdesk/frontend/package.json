{
  "name": "it-helpdesk-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/attachments.test.ts",
